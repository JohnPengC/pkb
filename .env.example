# ── 聊天模型（云端，默认 Kimi 开放平台；也可填 DeepSeek 等任何 OpenAI 兼容端点）
# 可用模型列表：curl -H "Authorization: Bearer $CHAT_API_KEY" $CHAT_BASE_URL/models
CHAT_BASE_URL=https://api.moonshot.cn/v1
CHAT_API_KEY=sk-your-key
CHAT_MODEL=moonshot-v1-8k
# 也可换更新的 kimi-k3.1-pro / kimi-k3.1-pro-highspeed（模型名以 /models 返回为准）
# Kimi 编程订阅 key（sk-kimi- 开头）：需把 CHAT_BASE_URL 改为 https://api.kimi.com/coding/v1

# ── Embedding 模型（默认本地 Ollama bge-m3，1024 维，与库结构匹配）
# 注意：Kimi/Moonshot 没有 embeddings 接口，且 text-embedding-3-small 是 1536 维，
# 与向量列宽 1024 不符——请勿把 EMBEDDING_* 指向 api.moonshot.cn。
# 需先启动 local-llm 并拉取模型：docker compose --profile local-llm up -d ollama
#                                   docker exec pkb-ollama ollama pull bge-m3
EMBEDDING_BASE_URL=http://ollama:11434/v1
EMBEDDING_API_KEY=ollama
EMBEDDING_MODEL=bge-m3

# 云端 embedding 替代（示例：硅基流动 SiliconFlow 托管 bge-m3，OpenAI 兼容、1024 维）
# EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
# EMBEDDING_API_KEY=sk-your-siliconflow-key
# EMBEDDING_MODEL=BAAI/bge-m3

# 聊天也走本地 Ollama 的全本地预设（需 ollama pull qwen2.5:7b）
# CHAT_BASE_URL=http://ollama:11434/v1
# CHAT_API_KEY=ollama
# CHAT_MODEL=qwen2.5:7b

PKB_STORAGE_PATH=./storage
